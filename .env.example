# StockFlow AI local environment example

# Core API / PostgreSQL
STOCKFLOW_DB_URL=jdbc:postgresql://localhost:5432/stockflow
STOCKFLOW_DB_USERNAME=stockflow_app
STOCKFLOW_DB_PASSWORD=stockflow_dev
STOCKFLOW_DB_POOL_SIZE=10
SERVER_PORT=8080

# Python services
STOCKFLOW_FORECAST_API_URL=http://127.0.0.1:8101
STOCKFLOW_OPTIMISATION_API_URL=http://127.0.0.1:8102
STOCKFLOW_CORE_API_URL=http://127.0.0.1:8080

# Action MCP remains disabled unless deliberately enabled for a controlled demo.
STOCKFLOW_ENABLE_ACTIONS=false
